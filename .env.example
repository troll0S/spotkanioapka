# Skopiuj do .env i uzupełnij:   copy .env.example .env
# Plik .env jest w .gitignore — nie trafi do repozytorium.

# Konto startowe. Używane TYLKO przy pustej bazie — zakłada z niego
# pierwszego superadmina. Potem konta żyją w bazie i zmienia się je
# w panelu (/archive → zakładka Konta), a te zmienne przestają cokolwiek
# znaczyć.
#
# Tryb lokalny (jedno Wi-Fi): zabezpieczeniem jest sama sieć, więc cokolwiek.
# Tryb zdalny (tunel): adres jest PUBLICZNY — tu hasło naprawdę coś chroni.
#                      start.ps1 -Remote odmówi startu poniżej 12 znaków.
# Hasło musi spełniać tę samą politykę, co każde inne konto: co najmniej
# 8 znaków, w tym wielka litera, mała litera, cyfra i znak specjalny.
# Konto startowe nie powstanie, jeśli hasło jej nie spełnia.
SUPERADMIN_LOGIN=admin
ADMIN_PASSWORD=Zmien-To-Haslo1!

# Adres, pod którym aplikacja jest widoczna dla telefonów (kod QR).
#
# ZOSTAW PUSTE — i tak jest ustalany automatycznie przy każdym starcie:
#   .\start.ps1   wykrywa aktualny adres laptopa w sieci i podaje go aplikacji
#
# Wpisana tu wartość ma pierwszeństwo nad wszystkim, więc po przeniesieniu
# laptopa do innej sieci zostałaby martwym adresem i telefony nie miałyby gdzie
# się połączyć. Wpisuj tylko adres, który się nie zmienia — np. własną domenę
# w tunelu Cloudflare.
PUBLIC_URL=
